# ==========================================
# Root .gitignore for IELTSTEST
# ==========================================

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables & sensitive config (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example
application-local.properties
**/application-local.properties

# Node & Frontend dependencies & build outputs
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
.tscache/
**/.tscache/
*.tsbuildinfo
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# Java / Maven build outputs
target/
**/target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
HELP.md

# IDE & Editor files
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.springBeans
.sts4-cache
.apt_generated
.factorypath

# Temporary files
*.tmp
*.bak
*.swp
*.swo
