# ==========================================
# IELTS Backend Environment Variables Template
# Copy this file to .env or set them in your system/IDE
# ==========================================

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/SWP?retryWrites=true&w=majority

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.languages.io.vn/login/oauth2/code/google

# OpenAI API
OPENAI_API_KEY=sk-proj-your-openai-api-key

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=swpieltsbucket
AWS_S3_REGION=ap-southeast-1

# Azure Speech Services
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/

# Email (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password

# JWT Secret (Min 256 bits)
JWT_SECRET=your-256-bit-jwt-secret-key-must-be-secure

# VNPay Payment Gateway
VNPAY_TMN_CODE=NN4P08IV
VNPAY_SECRET_KEY=your-vnpay-secret-key
VNPAY_RETURN_URL=https://www.languages.io.vn/vnpay-result

# Pronunciation Dictionary Path
CMUDICT_FILE_PATH=/home/ubuntu/backend/cmudict-0.7b.txt
